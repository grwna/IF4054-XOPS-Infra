# Helm dependency build artifacts (regenerated by scripts/render.sh via
# `helm dependency build`); the umbrella chart's Chart.yaml is the source of
# truth for which chart versions are used.
helm/charts/app/charts/
helm/charts/app/Chart.lock

# Rendered manifests are fully reproducible from helm/ via
# `./scripts/render.sh`. Not committed because they also bake in a
# randomly-generated placeholder Secret value (orders-db password) on every
# render, which would make committed output non-deterministic and look like
# a leaked credential even though it's unused (orders runs with in-memory
# persistence).
rendered/
